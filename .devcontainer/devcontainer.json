{
  "name": "agentcore-quality（コンテナ内で AWS にログインする）",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/aws-cli:1": {}
  },
  "containerEnv": {
    // Python の仮想環境をワークスペースの外に置く。
    // 手元（macOS / Windows）の .venv を上書きしないため
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv",
    "AWS_REGION": "ap-northeast-1"
  },
  "mounts": [
    // CDK の依存パッケージもコンテナ専用の領域に置く
    "source=agentcore-quality-cdk-node-modules,target=${containerWorkspaceFolder}/01-quality-app/agentcore/cdk/node_modules,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
